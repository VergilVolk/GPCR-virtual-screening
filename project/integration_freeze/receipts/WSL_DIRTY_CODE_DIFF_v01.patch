diff --git a/project/environment_pacer_dc_md.yml b/project/environment_pacer_dc_md.yml
index cba39cc..7ccfe54 100644
--- a/project/environment_pacer_dc_md.yml
+++ b/project/environment_pacer_dc_md.yml
@@ -4,9 +4,24 @@ channels:
 dependencies:
   - python=3.11
   - openmm>=8.2
+  # OpenMM's CUDA platform compiles its kernels at runtime through NVRTC, so the
+  # CUDA version that matters is cuda-nvrtc's, not openmm's.  The host driver
+  # (596.08) supports CUDA <= 13.2; an unpinned solve picks cuda-nvrtc 13.4 and
+  # every CUDA context dies with CUDA_ERROR_UNSUPPORTED_PTX_VERSION (222).
+  # openmm 8.6.1 requires cuda-nvrtc >=13.0.88,<14, so pinning to 13.2 needs no
+  # rebuild and keeps the MD stack identical.
+  - cuda-version=13.2
+  - cuda-nvrtc=13.2.*
   # Frozen compatible OpenFF stack.  Toolkit 0.16.x is incompatible with
   # Interchange 0.4.5 (missing NAGLChargesHandler), despite successful imports.
   - openmmforcefields=0.14.1
+  # openmmforcefields 0.14.1 (build pyhd8ed1ab_3) does NOT declare this runtime
+  # dependency, but openmmforcefields/utils.py imports it unconditionally.
+  # Without it `import openmmforcefields` dies with ModuleNotFoundError.
+  # It cannot be left out of this file: the smoke-test script
+  # scripts/audit_pacer_dc_ligand_parameterization.py imports
+  # openmmforcefields.generators at module level.
+  - importlib_resources
   # Base package is sufficient for GAFF/SMIRNOFF parameterization and avoids
   # pulling optional NAGL/PyTorch/CUDA dependencies into the CPU environment.
   - openff-toolkit-base=0.16.5
